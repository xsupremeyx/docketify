// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String?           @unique
  passwordHash     String?           @map("password_hash")
  googleId         String?           @unique @map("google_id")
  appleId          String?           @unique @map("apple_id")
  name             String?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz
  purgedAt         DateTime?         @map("purged_at") @db.Timestamptz

  uploadSessions   UploadSession[]
  analysisJobs     AnalysisJob[]
  auditLogs        AuditLog[]
  deletionRequests DeletionRequest[]

  @@map("users")
}

model UploadSession {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  consentGivenAt DateTime     @map("consent_given_at") @db.Timestamptz
  consentIp      String?      @map("consent_ip")
  consentText    String       @map("consent_text")
  fileHash       String       @map("file_hash")
  fileName       String       @map("file_name")
  documentType   String?      @map("document_type")
  status         String       @default("pending")
  tempFilePath   String?      @map("temp_file_path")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  processedAt    DateTime?    @map("processed_at") @db.Timestamptz
  fileDeletedAt  DateTime?    @map("file_deleted_at") @db.Timestamptz

  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  analysisJobs   AnalysisJob[]

  @@map("upload_sessions")
}

model AnalysisJob {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId           String               @map("session_id") @db.Uuid
  userId              String?              @map("user_id") @db.Uuid
  status              String               @default("queued")
  startedAt           DateTime?            @map("started_at") @db.Timestamptz
  completedAt         DateTime?            @map("completed_at") @db.Timestamptz
  errorMsg            String?              @map("error_msg")

  session             UploadSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  clauses             Clause[]
  templateComparisons TemplateComparison[]

  @@map("analysis_jobs")
}

model Clause {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId            String           @map("job_id") @db.Uuid
  clauseType       String           @map("clause_type")
  riskLevel        String           @map("risk_level")
  summary          String?
  rawText          String?          @map("raw_text")
  position         Int?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz

  job              AnalysisJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  riskFlags        RiskFlag[]
  precedentMatches PrecedentMatch[]

  @@map("clauses")
}

model RiskFlag {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clauseId       String   @map("clause_id") @db.Uuid
  flagType       String?  @map("flag_type")
  severity       String   @default("low")
  description    String?
  recommendation String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  clause         Clause   @relation(fields: [clauseId], references: [id], onDelete: Cascade)

  @@map("risk_flags")
}

model PrecedentMatch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clauseId       String   @map("clause_id") @db.Uuid
  caseLawId      String   @map("case_law_id") @db.Uuid
  relevanceScore Float?   @map("relevance_score")
  matchedAt      DateTime @default(now()) @map("matched_at") @db.Timestamptz

  clause         Clause   @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  caseLaw        CaseLaw  @relation(fields: [caseLawId], references: [id], onDelete: Cascade)

  @@map("precedent_matches")
}

model TemplateComparison {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId           String      @map("job_id") @db.Uuid
  templateId      String      @map("template_id") @db.Uuid
  similarityScore Float?      @map("similarity_score")
  deviationNotes  String?     @map("deviation_notes")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz

  job             AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  template        Template    @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_comparisons")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model DeletionRequest {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  scope       String
  sessionId   String?   @map("session_id") @db.Uuid

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("deletion_requests")
}

model Template {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  type            String?
  sourceUrl       String               @map("source_url")
  sourceType      String?              @map("source_type")
  checksum        String?
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  chunks          TemplateChunk[]
  comparisons     TemplateComparison[]

  @@map("templates")
}

model TemplateChunk {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  chunkIndex  Int      @map("chunk_index")
  chunkText   String   @map("chunk_text")
  metadata    Json?
  embedding   Unsupported("vector(384)")?

  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_chunks")
}

model CaseLaw {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courtListenerId String?          @unique @map("court_listener_id")
  caseName        String?          @map("case_name")
  citation        String?
  jurisdiction    String?
  dateDecided     DateTime?        @map("date_decided") @db.Date
  summary         String?
  sourceUrl       String           @map("source_url")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz

  chunks          CaseLawChunk[]
  matches         PrecedentMatch[]

  @@map("case_law")
}

model CaseLawChunk {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId      String   @map("case_id") @db.Uuid
  chunkIndex  Int      @map("chunk_index")
  chunkText   String   @map("chunk_text")
  metadata    Json?
  embedding   Unsupported("vector(384)")?

  caseLaw     CaseLaw  @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("case_law_chunks")
}